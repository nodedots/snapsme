{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.jpg"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(favicon.jpg|favicon.ico|logo.jpg|nodedots.jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/nodedots.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    }
  ],
  "functions": {
    "api/extract-receipt.js": { "maxDuration": 30, "memory": 1024 },
    "api/extract-voice.js": { "maxDuration": 30, "memory": 1024 },
    "api/extract-income-doc.js": { "maxDuration": 30, "memory": 1024 },
    "api/extract-income-voice.js": { "maxDuration": 30, "memory": 1024 },
    "api/exchange-rates.js": { "maxDuration": 15 },
    "api/health.js": { "maxDuration": 10 },
    "api/firebase-config.js": { "maxDuration": 10 }
  }
}
