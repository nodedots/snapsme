rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBusinessMember(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/businesses/$(businessId)) &&
         get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role == "owner")
      );
    }

    // User Workspace Reference Documents (users/{userId})
    // Standard indirection pattern: on signup / invite acceptance we write a small
    // document at users/{uid} containing { businessId, role, displayName, email }.
    // Session restore reads this single doc instead of running collection-group queries
    // (which require composite indexes and extra rules).
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Collection-group rule for the members subcollection.
    // Allows a signed-in user to look up their own member record (by UID or email)
    // when resolving their workspace / accepting a pending invite.
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == memberId ||
        (resource.data.email == request.auth.token.email) ||
        (resource.data.userId == request.auth.uid)
      );
    }

    // Business Root Document
    // NOTE FOR ONBOARDING FLOW:
    // Firestore security rule allows an authenticated-but-not-yet-a-member user
    // to create their first business document prior to becoming a member.
    match /businesses/{businessId} {
      allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
      allow create: if isAuthenticated(); // Allowed for initial workspace creation during onboarding
      allow update: if isBusinessOwner(businessId);
      allow delete: if isBusinessOwner(businessId);

      // Members Subcollection
      // NOTE FOR ONBOARDING FLOW:
      // Allows an authenticated user to write their own initial "owner" member record
      // upon workspace setup (isUser(userId) permits creation prior to full member query validation).
      match /members/{userId} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        // User can update their own display profile or write initial owner record; owner can manage all members
        allow create, update: if isBusinessOwner(businessId) || isUser(userId);
        allow delete: if isBusinessOwner(businessId);
      }

      // Categories Subcollection
      match /categories/{categoryId} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Staff may edit / soft-delete their own active submissions.
      // 48h window is enforced in the client (recordPermissions.js); rules key off ownership.
      // Soft-deleted rows (deletedAt set) are owner-only for restore / further edits.
      // Hard delete remains owner-only.
      function isOwnActiveSubmission() {
        return resource.data.submittedBy == request.auth.uid &&
          (!('deletedAt' in resource.data) || resource.data.deletedAt == null);
      }

      function staffMayUpdateOwnRecord() {
        return isBusinessMember(businessId) &&
          isOwnActiveSubmission() &&
          // Prevent reassigning authorship
          request.resource.data.submittedBy == resource.data.submittedBy;
      }

      // Expenses Subcollection
      // Any member of the business can read all expenses (shared feed, FR15)
      // and create their own expense submissions. Owner: full update/delete.
      // Staff: update (edit + soft-delete) own active records only.
      match /expenses/{expenseId} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow create: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || staffMayUpdateOwnRecord();
        allow delete: if isBusinessOwner(businessId);
      }

      // Income Subcollection
      // Lightweight money-in log (NOT invoicing). Mirrors expense permissions.
      match /income/{incomeId} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow create: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || staffMayUpdateOwnRecord();
        allow delete: if isBusinessOwner(businessId);
      }
    }

    // Chat Links Collection (for Telegram / WhatsApp auth pairing)
    match /chatLinks/{linkCode} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.channel in ['telegram', 'whatsapp'];
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Top-Level Chat Link Lookup Collections (telegramLinks & whatsappLinks)
    // Authoritative lookup tables for webhook routing. Writable/readable strictly by server-side Cloud Functions (Admin SDK).
    match /telegramLinks/{telegramUserId} {
      allow read, write: if false;
    }

    match /whatsappLinks/{whatsappUserId} {
      allow read, write: if false;
    }

    // Top-Level API Key Lookup Collection (apiKeys)
    // Authoritative lookup table for inbound API authentication.
    // Writable/readable strictly by server-side Cloud Functions (Admin SDK).
    // Client-side access is completely denied.
    match /apiKeys/{apiKey} {
      allow read, write: if false;
    }
  }
}
