# ==============================================================================
# SnapSME Environment Variables Template (.env.example)
# Copy this file to .env and fill in your specific credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTH & FIRESTORE INTEGRATION
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ------------------------------------------------------------------------------
# 2. AI VISION & MULTI-MODAL RECEIPT / VOICE EXTRACTION
# ------------------------------------------------------------------------------
# Multi-Provider AI Failover (zero-downtime):
# Providers are tried in priority order. If one fails/rate-limits, the next
# configured provider is used automatically. At least one key is required.
#
# Failover priority can be changed with AI_PROVIDER_ORDER, e.g.
#   AI_PROVIDER_ORDER=nvidia,gemini,deepseek,perplexity
#
# Free-tier notes (as of 2026):
#   - Gemini 2.0 Flash: free tier on Google AI Studio (vision + text + audio)
#   - NVIDIA NIM: free via https://build.nvidia.com (vision + text, OpenAI-compatible)
#   - DeepSeek: low-cost, no permanent free tier (text-only)
#   - Perplexity: free trial credits only (text-only, sonar-pro)

# Google Gemini API Key (vision + text + audio — free tier available)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional Gemini model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM API Key (vision + text — free tier available at build.nvidia.com)
# NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
# Optional NVIDIA model / base URL overrides
# NVIDIA_MODEL=nvidia/llama-3.1-8b-vision-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# DeepSeek API Key (text-only — low cost, no free tier)
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# Optional DeepSeek model / base URL overrides
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Perplexity API Key (text-only — free trial credits only)
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
# Optional Perplexity model / base URL overrides
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Failover priority order (comma-separated, unlisted providers are appended last)
# AI_PROVIDER_ORDER=gemini,nvidia,deepseek,perplexity

# Baidu Unlimited-OCR Microservice Endpoint ($0 Token Cost Tier)
UNLIMITED_OCR_URL=http://localhost:8000/ocr/extract-receipt
ENABLE_UNLIMITED_OCR=true

# ------------------------------------------------------------------------------
# 3. LIVE EXCHANGE RATE CONVERSION API
# ------------------------------------------------------------------------------
# Real-time exchange rate endpoint (Decoupled API Key & URL template)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/{key}/latest/{base}

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# The @username you assigned to your bot (without the @)
TELEGRAM_BOT_USERNAME=snapsme_bot
# Public HTTPS URL where the Telegram webhook is reachable
# (e.g. https://yourdomain.com/api/bot/telegram/webhook)
TELEGRAM_WEBHOOK_URL=https://snapsme.com/api/bot/telegram/webhook

# ------------------------------------------------------------------------------
# 6. WHATSAPP BUSINESS CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
# Meta for Developers → WhatsApp Business Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
# Custom verify token you set when configuring the webhook in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=snapsme_verify_token
# Public HTTPS URL where the WhatsApp webhook is reachable
# (e.g. https://yourdomain.com/api/bot/whatsapp/webhook)
WHATSAPP_WEBHOOK_URL=https://yourdomain.com/api/bot/whatsapp/webhook
