# ==============================================================================
# SnapSME Environment Variables Template (.env.example)
# Copy this file to .env and fill in your specific credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTH & FIRESTORE INTEGRATION
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ------------------------------------------------------------------------------
# 2. AI VISION & MULTI-MODAL RECEIPT / VOICE EXTRACTION
# ------------------------------------------------------------------------------
# Google Gemini 2.5 Flash API Key for multi-modal receipt vision & voice parsing
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Baidu Unlimited-OCR Microservice Endpoint ($0 Token Cost Tier)
UNLIMITED_OCR_URL=http://localhost:8000/ocr/extract-receipt
ENABLE_UNLIMITED_OCR=true

# ------------------------------------------------------------------------------
# 3. LIVE EXCHANGE RATE CONVERSION API
# ------------------------------------------------------------------------------
# Real-time exchange rate endpoint (Decoupled API Key & URL template)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/{key}/latest/{base}

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# The @username you assigned to your bot (without the @)
TELEGRAM_BOT_USERNAME=snapsme_bot
# Public HTTPS URL where the Telegram webhook is reachable
# (e.g. https://yourdomain.com/api/bot/telegram/webhook)
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/bot/telegram/webhook

# ------------------------------------------------------------------------------
# 6. WHATSAPP BUSINESS CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
# Meta for Developers → WhatsApp Business Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
# Custom verify token you set when configuring the webhook in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=snapsme_verify_token
# Public HTTPS URL where the WhatsApp webhook is reachable
# (e.g. https://yourdomain.com/api/bot/whatsapp/webhook)
WHATSAPP_WEBHOOK_URL=https://yourdomain.com/api/bot/whatsapp/webhook
